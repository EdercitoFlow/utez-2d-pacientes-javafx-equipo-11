<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.democonsultorio.controller.MainController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCurp" text="CURP" />
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colEdad" text="Edad" />
            <TableColumn fx:id="colAlergias" text="Alergias" />
            <TableColumn fx:id="colTelefono" text="Telefono" />
            <TableColumn fx:id="colEstatus" text="Estatus" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER" spacing="15">
        <Button onAction="#abrirFormulario" text="Nuevo Paciente" style="-fx-padding: 8 15;" />
        <Button onAction="#consultar" text="Consultar" style="-fx-padding: 8 15;" />
        <Button onAction="#cambiarEstatus" text="Cambiar Estatus" style="-fx-padding: 8 15;" />
        <Button fx:id="btnEditar" onAction="#editar" text="Actualizar" style="-fx-padding: 8 15;" />
        <Button fx:id="btnEliminar" onAction="#eliminar" text="Eliminar" style="-fx-padding: 8 15; -fx-background-color: #ffcccc; -fx-text-fill: #990000;" />
    </HBox>

    <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #f4f4f4; -fx-padding: 10; -fx-background-radius: 5;">
        <Label fx:id="lblTotal" style="-fx-font-weight: bold;" />
        <Label fx:id="lblActivos" style="-fx-font-weight: bold; -fx-text-fill: green;" />
        <Label fx:id="lblInactivos" style="-fx-font-weight: bold; -fx-text-fill: red;" />
    </HBox>

</VBox>